#!/usr/bin/env bash
set -euo pipefail
# One compound command: under `curl ... | bash` the whole script is read before
# anything runs, so no later command can consume the rest of the script.
{
# Generated by build.sh; each release embeds its own artifact checksums.
version='@VERSION@'
base_url='@BASE_URL@'
ca_url="$base_url/s90-ca.crt"
ca_checksum='@DOWNLOAD_CA_SHA256@'
manifest_url='@MANIFEST_URL@'
usage='Usage: install.sh [--login|--service|--upgrade]'
[[ ${1:-} == "" || ${1:-} == --login || ${1:-} == --service || ${1:-} == --upgrade ]] || { echo "$usage" >&2; exit 2; }
[[ $# -le 1 ]] || { echo "$usage" >&2; exit 2; }
mode=${1:-install}
# Refuse to redirect or overwrite a pre-existing account configuration. An
# upgrade keeps the configuration and only replaces the program files.
if [[ $mode != --upgrade ]] && [[ -n ${MULTICA_PROFILE:-} || -e "$HOME/.multica/config.json" || -L "$HOME/.multica/config.json" ]]; then
  echo 'Existing configuration/profile found. Keep it and upgrade with: install.sh --upgrade' >&2
  exit 2
fi
case "$(uname -s)-$(uname -m)" in
  Linux-x86_64) platform=linux-amd64; checksum='@LINUX_AMD64@' ;;
  Linux-aarch64|Linux-arm64) platform=linux-arm64; checksum='@LINUX_ARM64@' ;;
  Darwin-x86_64) platform=darwin-amd64; checksum='@DARWIN_AMD64@' ;;
  Darwin-arm64) platform=darwin-arm64; checksum='@DARWIN_ARM64@' ;;
  *) echo 'Unsupported platform; use a matching release binary.' >&2; exit 2 ;;
esac

if [[ ${1:-} == --service ]]; then
  [[ $(uname -s) == Linux ]] || { echo '--service requires Linux systemd user services.' >&2; exit 2; }
  command -v systemctl >/dev/null
  systemctl --user show-environment >/dev/null
  [[ ! -e "$HOME/.config/systemd/user/multica.service" && ! -L "$HOME/.config/systemd/user/multica.service" ]] || {
    echo 'Existing multica.service found; refusing to replace it.' >&2; exit 2;
  }
fi
install_root=${MULTICA_ZH_TW_INSTALL_ROOT:-"$HOME/.local"}
case "$install_root" in
  /*) ;;
  *) echo 'Installation root must be absolute.' >&2; exit 2 ;;
esac
share_root="$install_root/share/multica-zh-tw"
destination="$share_root/$version"
wrapper="$install_root/bin/multica"
previous=''
lock="$share_root/.upgrade.lock"
tmp='' locked=false created=false committed=false
# Until the launcher points at the new version, a failure leaves no partial
# version directory behind, so a retry starts clean.
cleanup() {
  [[ -n "$tmp" ]] && rm -rf -- "$tmp"
  [[ $created == true && $committed == false ]] && rm -rf -- "$destination"
  [[ $locked == true ]] && rm -rf -- "$lock"
  return 0
}
trap cleanup EXIT
# Sortable key for X.Y.Z-zh-tw.N[-rc.M]; a release sorts after its candidates.
version_key() {
  [[ $1 =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)-zh-tw\.([0-9]+)(-rc\.([0-9]+))?$ ]] || return 1
  local rc=${BASH_REMATCH[6]:-999999999}
  printf '%010d%010d%010d%010d%010d' "$((10#${BASH_REMATCH[1]}))" "$((10#${BASH_REMATCH[2]}))" \
    "$((10#${BASH_REMATCH[3]}))" "$((10#${BASH_REMATCH[4]}))" "$((10#$rc))"
}
if [[ $mode == --upgrade ]]; then
  # Only replace a launcher this installer created: a hard link to
  # share/multica-zh-tw/<version>/launcher. Anything else is left untouched.
  [[ -f "$wrapper" && ! -L "$wrapper" && -d "$share_root" ]] || { echo "No zh-tw installation at $wrapper; install first." >&2; exit 2; }
  # One upgrade per installation root at a time (mkdir is atomic). Everything
  # below — reading the current version, switching, pruning — happens under it.
  if ! mkdir "$lock" 2>/dev/null; then
    holder=$(cat "$lock/pid" 2>/dev/null || true)
    if [[ -n "$holder" ]] && kill -0 "$holder" 2>/dev/null; then
      echo "Another upgrade (PID $holder) is in progress; retry later." >&2; exit 75
    fi
    # Left behind by an interrupted upgrade; take it over.
    rm -rf -- "$lock"
    mkdir "$lock" 2>/dev/null || { echo 'Another upgrade is starting; retry later.' >&2; exit 75; }
  fi
  locked=true
  echo $$ > "$lock/pid"
  for candidate in "$share_root"/*/launcher; do
    if [[ -f "$candidate" && "$candidate" -ef "$wrapper" ]]; then previous=$(basename "$(dirname "$candidate")"); break; fi
  done
  [[ -n "$previous" ]] || { echo "$wrapper is not managed by this installer; refusing to replace it." >&2; exit 2; }
  if [[ "$previous" == "$version" ]]; then echo "Already at $version."; exit 0; fi
  new_key=$(version_key "$version") && old_key=$(version_key "$previous") && [[ "$new_key" > "$old_key" ]] || {
    echo "Refusing to replace $previous with older or unrecognized $version. Roll back with the printed ln -f command instead." >&2
    exit 2
  }
  # Not the active version, and we hold the lock: a leftover from an
  # interrupted run. Start that version over.
  [[ -e "$destination" || -L "$destination" ]] && rm -rf -- "$destination"
elif [[ -e "$destination" || -L "$destination" || -e "$wrapper" || -L "$wrapper" ]]; then
  echo 'Existing installation found. Upgrade with: install.sh --upgrade' >&2
  exit 2
fi
for required in curl tar grep; do command -v "$required" >/dev/null; done
tmp=$(mktemp -d)
# Establish download trust before contacting the artifact server. A private-only inherited
# CA bundle must not hide the OS public roots. Keep explicitly provided roots.
public_ca=''
for candidate in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt /etc/ssl/cert.pem; do
  if [[ -f "$candidate" && -r "$candidate" && -s "$candidate" ]]; then public_ca="$candidate"; break; fi
done
[[ -n "$public_ca" ]] || { echo 'System CA bundle not found; install the OS ca-certificates package first.' >&2; exit 1; }
if [[ -n ${MULTICA_INSTALL_CA_FILE:-} && ( ! -f "$MULTICA_INSTALL_CA_FILE" || ! -r "$MULTICA_INSTALL_CA_FILE" || ! -s "$MULTICA_INSTALL_CA_FILE" ) ]]; then
  echo 'MULTICA_INSTALL_CA_FILE must name a readable, non-empty public CA certificate file.' >&2
  exit 1
fi
if grep -Eq -- '-----BEGIN .*PRIVATE KEY-----' "$public_ca"; then
  echo 'CA bundle contains a private key; use public CA certificates only.' >&2; exit 1
fi
cat "$public_ca" > "$tmp/download-ca.crt"
for candidate in "${CURL_CA_BUNDLE:-}" "${SSL_CERT_FILE:-}" "${MULTICA_INSTALL_CA_FILE:-}"; do
  if [[ -n "$candidate" && "$candidate" != "$public_ca" && -f "$candidate" && -r "$candidate" && -s "$candidate" ]]; then
    if grep -Eq -- '-----BEGIN .*PRIVATE KEY-----' "$candidate"; then
      echo 'CA bundle contains a private key; use public CA certificates only.' >&2; exit 1
    fi
    printf '\n' >> "$tmp/download-ca.crt"
    cat "$candidate" >> "$tmp/download-ca.crt"
  fi
done
# Bootstrap only the public CA bytes without relying on an already-trusted LAN
# certificate. The checksum in this trusted installer authenticates them BEFORE
# they become a trust root. No redirects, credentials, or artifact requests here.
sha256_file() {
  if command -v sha256sum >/dev/null; then sha256sum "$1"; else shasum -a 256 "$1"; fi
}
curl -q --insecure --proxy-cacert "$tmp/download-ca.crt" \
  --fail --silent --show-error --proto '=https' --max-filesize 1048576 \
  --connect-timeout 10 --max-time 60 "$ca_url" -o "$tmp/bootstrap-ca.crt"
actual=$(sha256_file "$tmp/bootstrap-ca.crt")
[[ ${actual%% *} == "$ca_checksum" ]] || { echo 'CA checksum mismatch; no certificate was trusted or installation written.' >&2; exit 1; }
printf '\n' >> "$tmp/download-ca.crt"
cat "$tmp/bootstrap-ca.crt" >> "$tmp/download-ca.crt"
# -q must be first: a user curlrc must not inject insecure or alternate downloads.
# HTTPS proxies have their own TLS verification, using the same approved roots.
if curl -q --cacert "$tmp/download-ca.crt" --proxy-cacert "$tmp/download-ca.crt" \
  --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
  "$base_url/multica-$platform.tar.gz" -o "$tmp/archive.tar.gz"; then
  :
else
  status=$?
  if [[ $status == 60 || $status == 77 ]]; then
    echo 'TLS verification failed while downloading the CLI; no installation was written.' >&2
    echo 'For a company TLS proxy, supply its administrator-verified public CA via MULTICA_INSTALL_CA_FILE and retry. TLS verification remains enabled.' >&2
  fi
  exit "$status"
fi
actual=$(sha256_file "$tmp/archive.tar.gz")
[[ ${actual%% *} == "$checksum" ]] || { echo 'Checksum mismatch.' >&2; exit 1; }
tar -xzf "$tmp/archive.tar.gz" -C "$tmp" multica LICENSE NOTICE s90-ca.crt
[[ -f "$tmp/multica" && ! -L "$tmp/multica" ]] || exit 1
mkdir -p "$install_root/bin" "$(dirname "$destination")"
# mkdir reserves the version directory without overwriting an existing install.
mkdir "$destination"
created=true
install -m 755 "$tmp/multica" "$destination/multica"
install -m 644 "$tmp/LICENSE" "$tmp/NOTICE" "$tmp/s90-ca.crt" "$destination/"
# Reuse the verified download trust and add the archive's checksum-pinned s90 CA.
cat "$tmp/download-ca.crt" > "$destination/ca-bundle.crt"
printf '\n' >> "$destination/ca-bundle.crt"
cat "$destination/s90-ca.crt" >> "$destination/ca-bundle.crt"
# Bash %q quotes spaces and metacharacters in the user's installation path.
{
  printf '#!/usr/bin/env bash\n'
  # The daemon checks the release channel shortly after start and every 24
  # hours, upgrades through this installer when idle, then restarts through
  # the launcher. Set MULTICA_DAEMON_AUTO_UPDATE=false beforehand to opt out.
  printf 'export MULTICA_DAEMON_AUTO_UPDATE=${MULTICA_DAEMON_AUTO_UPDATE:-true} MULTICA_DAEMON_AUTO_UPDATE_INTERVAL=${MULTICA_DAEMON_AUTO_UPDATE_INTERVAL:-24h}\n'
  printf 'export MULTICA_DAEMON_AUTO_RELOAD=true MULTICA_DAEMON_DYNAMIC_PORT=true\n'
  printf 'export MULTICA_ZH_TW_RELEASE_MANIFEST_URL=%q\n' "$manifest_url"
  printf 'export MULTICA_ZH_TW_LAUNCHER=%q MULTICA_ZH_TW_INSTALL_ROOT=%q\n' "$wrapper" "$install_root"
  printf 'export MULTICA_CA_CERT_FILE=%q\n' "$destination/ca-bundle.crt"
  printf 'export SSL_CERT_FILE=%q\n' "$destination/ca-bundle.crt"
  printf 'export CURL_CA_BUNDLE=%q\n' "$destination/ca-bundle.crt"
  printf 'export MULTICA_SERVER_URL=https://10.1.24.90:45671 MULTICA_APP_URL=https://10.1.24.90:45671\n'
  printf 'exec %q "$@"\n' "$destination/multica"
} > "$tmp/wrapper"
chmod 755 "$tmp/wrapper"
install -m 755 "$tmp/wrapper" "$destination/launcher"
if [[ $mode == --upgrade ]]; then
  # rename(2) swaps the launcher atomically; a daemon started from the previous
  # version keeps running until it restarts through the launcher.
  rm -f -- "$wrapper.next.$$"
  ln "$destination/launcher" "$wrapper.next.$$"
  mv -f "$wrapper.next.$$" "$wrapper"
  committed=true
  # Keep the current and previous versions for rollback; drop older ones. The
  # upgrade is already committed, so a failed removal is only a warning.
  for old in "$share_root"/*; do
    name=$(basename "$old")
    [[ "$name" == "$version" || "$name" == "$previous" ]] && continue
    if [[ "$name" =~ ^[0-9]+\.[0-9]+\.[0-9]+-zh-tw\.[0-9]+(-rc\.[0-9]+)?$ && -d "$old" && ! -L "$old" ]]; then
      rm -rf -- "$old" 2>/dev/null || printf 'Warning: could not remove old version %s\n' "$old" >&2
    fi
  done
  printf 'Upgraded %s -> %s.\n' "$previous" "$version"
  printf 'Rollback: ln -f %q %q\n' "$share_root/$previous/launcher" "$wrapper"
  exit 0
fi
# A hard link creates the destination atomically and fails if already present.
ln "$destination/launcher" "$wrapper"
committed=true
# New installs keep task working directories separate from config and tokens.
"$wrapper" config set workspaces_root "$HOME/.multica/workspaces"
printf 'Installed %s.\n' "$version"
printf 'Command: %s\n' "$wrapper"
case ":$PATH:" in
  *":$install_root/bin:"*) ;;
  *) printf 'Add to PATH: export PATH=%q:"$PATH"\n' "$install_root/bin" ;;
esac

if [[ ${1:-} == --login || ${1:-} == --service ]]; then
  # Under `curl ... | bash` stdin is the script itself; read from the terminal.
  if [[ -n ${BASH_SOURCE[0]:-} && -f ${BASH_SOURCE[0]} ]]; then
    "$wrapper" login --token
  elif { : < /dev/tty; } 2>/dev/null; then
    "$wrapper" login --token < /dev/tty
  else
    printf 'No terminal for login. Run: %q login --token\n' "$wrapper" >&2; exit 2
  fi
  if [[ ${1:-} == --service ]]; then
    # Escape quoted systemd values, including specifiers and ExecStart dollars.
    unit_escape() { local value=$1; value=${value//\\/\\\\}; value=${value//\"/\\\"}; value=${value//%/%%}; printf '%s' "$value"; }
    unit_wrapper=$(unit_escape "$wrapper")
    unit_wrapper=${unit_wrapper//\$/\$\$}
    unit_path=$(unit_escape "$PATH")
    mkdir -p "$HOME/.config/systemd/user"
    cat > "$HOME/.config/systemd/user/multica.service" <<UNIT
[Unit]
Description=Multica user daemon
After=network-online.target

[Service]
Type=simple
ExecStart="$unit_wrapper" daemon start --foreground
Environment="PATH=$unit_path"
Environment=MULTICA_DAEMON_SUPERVISOR=systemd
Restart=on-failure
RestartSec=5
TimeoutStopSec=90

[Install]
WantedBy=default.target
UNIT
    systemctl --user daemon-reload
    systemctl --user enable --now multica.service
    ready=false
    for ((attempt=0; attempt<45; attempt++)); do
      if "$wrapper" daemon status --output json | grep -Eq '\"status\"[[:space:]]*:[[:space:]]*\"running\"'; then ready=true; break; fi
      sleep 1
    done
    [[ $ready == true ]] || { echo 'Service started but registration readiness timed out. Check journalctl --user -u multica.service.' >&2; exit 1; }
    echo 'Service ready. Stop: systemctl --user stop multica.service'
    echo 'Restart: systemctl --user restart multica.service'
    echo 'Starts with your user session; boot without login requires administrator-managed lingering.'
  else
    "$wrapper" daemon start
  fi
else
  printf 'Next: %q login --token\nThen: %q daemon start\n' "$wrapper" "$wrapper"
fi
exit 0
}
